[Unit]
Description=Songhealth Photo Bridge
Requires=songhealth-nextcloud.container
After=songhealth-nextcloud.container

[Container]
Image=localhost/songhealth-photo-bridge:0.1.0
ContainerName=songhealth-photo-bridge

Network=songhealth.network
NetworkAlias=photo-bridge

PublishPort=127.0.0.1:18089:18089

Secret=photo_nextcloud_password,target=photo_nextcloud_password
Secret=photo_ticket_secret,target=photo_ticket_secret

Environment=NODE_ENV=production

Environment=PHOTO_NEXTCLOUD_URL=http://nextcloud
Environment=PHOTO_NEXTCLOUD_USER=songhealth-admin
Environment=PHOTO_NEXTCLOUD_PASSWORD_FILE=/run/secrets/photo_nextcloud_password

Environment="PHOTO_ROOT=/คลังภาพ สสอ.สอง"
Environment=PHOTO_INBOX=00_INBOX_รอจัดหมวด
Environment=PHOTO_ARCHIVE=99_ARCHIVE_คลังภาพเก่า

Environment=PHOTO_TICKET_SECRET_FILE=/run/secrets/photo_ticket_secret
Environment=PHOTO_TICKET_TTL_SECONDS=300
Environment=PHOTO_MAX_UPLOAD_BYTES=26214400

Environment=PHOTO_LISTEN_HOST=0.0.0.0
Environment=PHOTO_LISTEN_PORT=18089

[Service]
Restart=always

[Install]
WantedBy=default.target
